## /etc/fstab - Configure the auto-mount partitions on boot
##
## PARTUUID= robust way for named device, fstab(5) for details
## The commands to show mounted fs info `cat /etc/mtab` or `findmnt`
##
## The commands to show the info of the EFI-type-disk in readable detials
## lsblk -o NAME,FSTYPE,FSSIZE,FSUSE%,FSUSED,MOUNTPOINT,LABEL,UUID,PARTLABEL,PARTUUID /dev/nvme0n1

## Disk Partition                               Mount Point   FS Type   Mount Options                         dump  fsck
PARTUUID=c4efee92-fb3f-2c43-b654-d130f40a430f   /boot/efi     vfat      defaults                              0     2
PARTUUID=0b024420-657e-5042-a521-24f5ae1979a3   /             ext4      defaults                              0     1
tmpfs                                           /tmp          tmpfs     defaults,noatime,mode=1777            0     0

## FAQs for SWAP => https://help.ubuntu.com/community/SwapFaq
PARTUUID=b3a01835-8dc9-7f4b-afad-457487970df8   none          swap      defaults                              0     0
#/swapfile                                      swap          swap      defaults                              0     0

