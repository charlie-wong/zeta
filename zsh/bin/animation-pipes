# Animated pipes terminal screensaver.

VERSION=2026.05.03

BRMAX=32768  # Bash RANDOM maximum + 1 -> 2^15

PNUM=1      # number of pipes to grow up
FR=75       # frame rate
GSP=12      # going straight probability
MAXCN=5000  # max characters before reset screen

TW=80  # terminal width
TH=25  # terminal height

# ab -> TYPES[][idx] = a*4 + b
# 0: up, 1: right, 2: down, 3: left
# 00 means going up   , then going up   -> ┃
# 12 means going right, then going down -> ┓
TYPES=(
#    x    xx    x
#  0123456789abcdef
  "┃┏ ┓┛━┓  ┗┃┛┗ ┏━" # -t 0   default
  "│╭ ╮╯─╮  ╰│╯╰ ╭─" # -t 1   round
  "│┌ ┐┘─┐  └│┘└ ┌─" # -t 2   weak
  "║╔ ╗╝═╗  ╚║╝╚ ╔═" # -t 3   double
  "|+ ++-+  +|++ +-" # -t 4   add/sub
  "|/ \/-\  \|/\ /-" # -t 5
  ".. ....  .... .." # -t 6   dots
  ".o oo.o  o.oo o." # -t 7
  "-\ /\|/  /-\/ \|" # -t 8   railway
  "╿┍ ┑┚╼┒  ┕╽┙┖ ┎╾" # -t 9   knobby
)
#         上 右 下 左
# 上 0*4  0, 1, x, 3
# 右 1*4  4, 5, 6, x
# 下 2*4  x, 9, A, B
# 左 3*4  C, x, E, F

# selected pipe
SPTI=() # pipe types (index to TYPES[])
SPTN=0  # number of selected pipe types
SPCI=() # pipe color index for tput setaf
SPCN=0  # number of selected pipe colors
ATTR=() # pre-generated escape codes from BOLD, NOCOLOR

# switches
RNDSTART=0  # randomize starting position and direction
BOLD=1      # no bold effect
NOCOLOR=0   # no color
KEEPCT=0    # keep pipe color and type when crossing edges

# print help message in 72-char width
print_help() {
  local cgap
  printf -v cgap '%*s' $(( 15 - ${#COLORS} )) ''
  cat <<HELP
Usage: $(basename $0) [OPTION] ...

Animated pipes terminal screensaver.

Note: -t and -c can be used more than once.

  -p [1-]               number of pipes (D=1)
  -t [0-$(( ${#TYPES[@]} - 1 ))]              pipe type (D=0)
  -t c[16 chars]        custom pipe type
  -c [0-$COLORS]${cgap}pipe color INDEX (TERM=$TERM)
                        can be hexadecimal with '#' prefix
                        (D=-c 1 -c 2 ... -c 7 -c 0)
  -f [20-100]           framerate (D=75)
  -s [5-15]             going straight probability, 1 in (D=12)
  -r [0-]               reset after (D=5000) characters, 0 if no reset
  -R                    randomize starting position and direction
  -B                    no bold effect
  -C                    no color
  -K                    keep pipe color and type when crossing edges
  -h                    print this help message
  -v                    print version number

HELP
}

# parse command-line options
# It depends on a valid COLORS which is set by _CP_init_termcap_vars
parse() {
  # test if $1 is a natural number in decimal, an integer >= 0
  is_N() {
    [[ -n $1 && -z ${1//[0-9]} ]]
  }

  # test if $1 is a hexadecimal string
  is_hex() {
    [[ -n $1 && -z ${1//[0-9A-Fa-f]} ]]
  }

  # print error message for invalid argument to standard error, this
  # - mimics getopts error message
  # - use all positional parameters as error message
  # - has a newline appended
  # $arg and $OPTARG are the option name and argument set by getopts.
  pearg() {
    printf "%s: -$arg invalid argument -- $OPTARG; %s\n" "$0" "$*" >&2
  }

  OPTIND=1
  while getopts "p:t:c:f:s:r:RBCKhv" arg; do
    case $arg in
      p)
        if is_N "$OPTARG" && (( OPTARG > 0 )); then
          PNUM=$OPTARG
        else
          pearg 'must be an integer and greater than 0'
          return 1
        fi
        ;;
      t)
        if [[ "$OPTARG" = c???????????????? ]]; then
          SPTI+=( ${#TYPES[@]} )
          TYPES+=( "${OPTARG:1}" )
        elif is_N "$OPTARG" && (( OPTARG < ${#TYPES[@]} )); then
          SPTI+=( $OPTARG )
        else
          pearg "must be an integer and from 0 to $((${#TYPES[@]} - 1)) or a custom type"
          return 1
        fi
        ;;
      c)
        if [[ $OPTARG == '#'* ]]; then
          if ! is_hex "${OPTARG:1}"; then
            pearg 'unrecognized hexadecimal string'
            return 1
          fi
          if ((16$OPTARG >= COLORS)); then
            pearg "hexadecimal must be from #0 to #$(printf '%X' $(( COLORS - 1 )) )"
            return 1
          fi
          SPCI+=( $(( 16$OPTARG )) )
        elif is_N "$OPTARG" && (( OPTARG < COLORS )); then
          SPCI+=( $OPTARG )
        else
          pearg "must be an integer and from 0 to $(( COLORS - 1 )) or a hex string with # prefix"
          return 1
        fi
        ;;
      f)
        if is_N "$OPTARG" && (( OPTARG >= 20 && OPTARG <= 100 )); then
          FR=$OPTARG
        else
          pearg 'must be an integer and from 20 to 100'
          return 1
        fi
        ;;
      s)
        if is_N "$OPTARG" && (( OPTARG >= 5 && OPTARG <= 15 )); then
          GSP=$OPTARG
        else
          pearg 'must be an integer and from 5 to 15'
          return 1
        fi
        ;;
      r)
        if is_N "$OPTARG"; then
          MAXCN=$OPTARG
        else
          pearg 'must be a non-negative integer'
          return 1
        fi
        ;;
      R) RNDSTART=1;;
      B) BOLD=0;;
      C) NOCOLOR=1;;
      K) KEEPCT=1;;
      h)
        print_help
        exit 0
        ;;
      v) echo "$(basename -- "$0") $VERSION"
        exit 0
        ;;
      *)
        return 1
    esac
  done

  shift $(( OPTIND - 1 ))
  if (( $# )); then
    printf "$0: illegal arguments -- $*; no arguments allowed\n" >&2
    return 1
  fi
}

cleanup-exit() {
  # clear out standard input
  read -t 0.001 && cat < /dev/stdin > /dev/null

  tput reset # fix for konsole, see pipeseroni/pipes.sh#43
  tput rmcup # 退出坐标定位模式
  tput cnorm # 光标正常化(退出 civis 模式)
  stty echo  # 开启 echo 属性
  printf "$SGR0"
  exit 0
}

term-resize() {
  TW=$(tput cols)   # 终端列数
  TH=$(tput lines)  # 终端行数
}

init-screen() {
  # https://invisible-island.net/ncurses/man/tput.1.html
  # https://invisible-island.net/ncurses/man/terminfo.5.html
  stty -echo # 关闭 echo 属性
  tput smcup # 坐标定位模式
  tput civis # make cursor invisible
  tput clear # clear screen

  term-resize
  trap cleanup-exit HUP TERM
  trap term-resize  SIGWINCH
}

# current pipe char status
x=()  # current position
y=()
c=()  # current escape codes

# v[i] * 16 + l[i] * 4 + n[i]
v=()  # current pipe types
l=()  # current directions
n=()  # new directions

init-pipes() {
  local i ci vi

  ci=$((KEEPCT ? 0 : SPCN * RANDOM / BRMAX))
  vi=$((KEEPCT ? 0 : SPTN * RANDOM / BRMAX))
  for ((i = 0; i < PNUM; i++)); do
    ((
      n[i] = 0,
      v[i] = SPTI[vi],
      l[i] = RNDSTART ? RANDOM % 4 : 0,
      x[i] = RNDSTART ? TW * RANDOM / BRMAX : TW / 2,
      y[i] = RNDSTART ? TH * RANDOM / BRMAX : TH / 2
    ))
    c[i]=${ATTR[ci]}
    (( ci = (ci + 1) % SPCN, vi = (vi + 1) % SPTN ))
  done
}

main() {
  # simple pre-check of TERM, tput's error message should be enough
  tput -T "$TERM" sgr0 >/dev/null || return $?

  COLORS=$(   tput colors )  # COLORS - 1 == maximum color index for -c argument
  SGR0=$(     tput sgr0 ) # turn off all attributes
  SGR_BOLD=$( tput bold ) # turn on bold mode

  parse "$@" || return $?

  # set default values if not by options
  (( ${#SPTI[@]} )) || SPTI=( 0 )
  SPTN=${#SPTI[@]}
  (( ${#SPCI[@]} )) || SPCI=( 1 2 3 4 5 6 7 0 )
  SPCN=${#SPCI[@]}

  # generate ATTR based on BOLD (SGR_BOLD), NOCOLOR
  local i
  for ((i = 0; i < SPCN; i++)) {
    ATTR[i]=$SGR0
    (( BOLD ))    && ATTR[i]+=$SGR_BOLD
    # Set foreground color to #1, using ANSI escape
    (( NOCOLOR )) || ATTR[i]+=$(tput setaf ${SPCI[i]})
  }

  local i j sets=()
  for ((i = 0; i < ${#TYPES[@]}; i++)) {
    for ((j = 0; j < 16; j++)) {
      sets+=("${TYPES[i]:j:1}")
    }
  }
  unset i j

  init-screen
  init-pipes

  # any key press exits the loop and this script
  trap 'break 2' INT

  local i cnter=0
  while REPLY=; do
    read -t 0.0$(( 1000 / FR )) -n 1 2>/dev/null

    case "$REPLY" in
      P) (( GSP = GSP <  15 ? GSP + 1 : GSP )) ;;
      O) (( GSP = GSP >   3 ? GSP - 1 : GSP )) ;;
      F) (( FR  = FR  < 100 ? FR  + 1 : FR  )) ;;
      D) (( FR  = FR  >  20 ? FR  - 1 : FR  )) ;;
      B) (( BOLD    = (BOLD    + 1) % 2 )) ;;
      C) (( NOCOLOR = (NOCOLOR + 1) % 2 )) ;;
      K) (( KEEPCT  = (KEEPCT  + 1) % 2 )) ;;
      ?) break ;;
    esac

    for (( i = 0; i < PNUM; i++ )); do
      # New position
      # l[] direction = 0: up, 1: right, 2: down, 3: left
      (( l[i] % 2 )) && (( x[i] += -l[i] + 2 )) || (( y[i] += l[i] - 1 ))

      # Loop on edges (change color on loop)
      if (( !KEEPCT && (x[i] >= TW || x[i] < 0 || y[i] >= TH || y[i] < 0) )); then
        c[i]=${ATTR[SPCN * RANDOM / BRMAX]}
        (( v[i] = SPTI[SPTN * RANDOM / BRMAX] ))
      fi
      (( x[i] = ( x[i] + TW ) % TW, y[i] = ( y[i] + TH ) % TH ))

      # new turning direction
      ((
        n[i] = GSP * RANDOM / BRMAX - 1,
        n[i] = n[i] >= 0 ? l[i] : l[i] + ( 2 * ( RANDOM % 2 ) - 1 ),
        n[i] = ( n[i] + 4 ) % 4
      ))

      # Print
      printf '\e[%d;%dH%s%s'  \
        $(( y[i] + 1 ))  $(( x[i] + 1 ))  ${c[i]}  \
        "${sets[ v[i] * 16 + l[i] * 4 + n[i] ]}"

      l[i]=${n[i]}
    done

    # cnter is iteration counter for MAXCN
    (( MAXCN > 0 && cnter * PNUM >= MAXCN )) && tput reset && tput civis && cnter=0 || (( cnter++ ))
  done

  cleanup-exit
}

# when being sourced, $0 == bash, only invoke main when they are the same
[[ "$0" != "$BASH_SOURCE" ]] ||  main "$@"
