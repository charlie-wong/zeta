# 重置 bcompare 的试用时间
for it in "bcompare bcompare3 bcompare4 bcompare5"; do
  if [[ -f "${HOME}/.config/${it}/registry.dat" ]]; then
    echo "Deleting ${HOME}/.config/${it}/registry.dat"
    rm --force "${HOME}/.config/${it}/registry.dat"
    break
  fi
done
