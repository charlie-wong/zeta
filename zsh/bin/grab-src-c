echo "递归扫描当前目录，查找所有 C/C++ 源文件 ..."
FILES_LIST_LOG="files-list.log"
echo "=> ${PWD}/${FILES_LIST_LOG}"

find ${PWD} -type f \( \
  -name "*.c"   -o \
  -name "*.h"   -o \
  -name "*.cc"  -o \
  -name "*.cpp" -o \
  -name "*.cxx" -o \
  -name "*.hh"  -o \
  -name "*.hpp" -o \
  -name "*.hxx" \) > ${FILES_LIST_LOG}

cat "${FILES_LIST_LOG}"
