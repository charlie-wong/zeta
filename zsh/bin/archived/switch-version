RESET="\e[0m"; GREEN="\e[32m"; BLUE="\e[34m";

# 版本切换控制
case "$1" in
  gcc|GCC)
    sudo update-alternatives --config gcc
    sudo update-alternatives --config cpp
    sudo update-alternatives --config g++
    sudo update-alternatives --config gcc-ar
    sudo update-alternatives --config gcc-nm
    sudo update-alternatives --config gcc-ranlib
    # Verify installation
    echo -e "Current ${GREEN}GCC${RESET} Version"
    update-alternatives --display gcc
    update-alternatives --display g++
    echo
    gcc --version
    g++ --version
    ;;
  java|JAVA)
    sudo update-alternatives --config jar
    sudo update-alternatives --config java
    sudo update-alternatives --config javac
    sudo update-alternatives --config javah
    sudo update-alternatives --config javaws
    sudo update-alternatives --config javadoc
    sudo update-alternatives --config mozilla-javaplugin.so
    # Verify installation
    echo -e "Current ${GREEN}JDK${RESET} Version"
    update-alternatives --display java
    update-alternatives --display javac
    echo
    java -version
    javac -version
    echo -e "${BLUE}迅为${RESET} Android 3.0 编译需要 ${GREEN}JDK 6${RESET}"
    ;;
  python|PYTHON)
    sudo update-alternatives --config python
    # Verify installation
    echo -e "Current ${GREEN}Python${RESET} Version"
    update-alternatives --display python
    echo
    python --version
    ;;
  *)
    echo "${0##*/} [gcc|java|python]"
    ;;
esac

