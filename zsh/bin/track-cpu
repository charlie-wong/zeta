# Track the most CPU intensives, in order to debug PC hang
while true; do
  echo "%CPU %MEM ARGS $(date '+%F %T')"
  ps -e -o pcpu,pmem,args --sort=pcpu | cut -d" " -f1-5 | tail -30
  sleep 1;
done >> ${HOME}/ps.log
