set -eu
function no-cmd() { ! command -v "$1" > /dev/null; }
no-cmd snap && exit

# CLOSE ALL SNAPS BEFORE RUNNING THIS
# NOTE Removes old revisions of snaps

# while read 以前一个命令的输出作为输入
LANG=en_US.UTF-8 snap list --all | awk '/disabled/{ print $1, $3 }' |
while read snapname revision; do
  echo -n "Remove - ${snapname}-${revision}  Yes or No (Y) ?"
  read -ru 2 usrInput # -u 2 表示内层 read 从 stderr 读取用户输入
  if [[ "${usrInput}" != "N" ]]; then
    sudo snap remove "${snapname}" --revision="${revision}"
    echo "Remove - ${snapname}$-${revision} DONE"
  else
    echo "Remove - ${snapname}$-${revision} SKIP"
  fi
  echo
done
