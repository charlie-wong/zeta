[[ -z "${ZCOLOR}" || ! -f "${ZCOLOR}" ]] && exit 255
source "${ZCOLOR}" # 加载终端彩色消息输出显示函数库

function has-cmd() {  command -v "$1" > /dev/null; }
function no-cmd() { ! command -v "$1" > /dev/null; }

no-cmd git && exit

# 同时重定向标准输出和标准错误
# &> /dev/null         Bash/ZSH shortcut
#  > /dev/null 2>&1    POSIX-compatible shell
isInsideGitWorkTree="$(git rev-parse --is-inside-work-tree 2> /dev/null)"
(( $? != 0 )) && exit 101

DOT_GIT_DIR="${PWD}" # bare 库
if ${isInsideGitWorkTree}; then
  DOT_GIT_DIR="$(git rev-parse --show-toplevel)/.git"
fi

echo "$(@G3 '(.git)') $(@Y3 ${DOT_GIT_DIR})"

function delete-dot-git-trash() {
  if [[ -f "${DOT_GIT_DIR}/$1" ]]; then
    echo "$(@R3 delete) $(@D9 "${DOT_GIT_DIR}/")$(@P3 $1)"
    rm --force "${DOT_GIT_DIR}/$1"
  elif [[ -d "${DOT_GIT_DIR}/$1" ]]; then
    echo "$(@R3 delete) $(@D9 "${DOT_GIT_DIR}/")$(@P3 "$1/")"
    rm --force --recursive "${DOT_GIT_DIR}/$1"
  fi
}

delete-dot-git-trash ORIG_HEAD
delete-dot-git-trash FETCH_HEAD
delete-dot-git-trash COMMIT_EDITMSG

delete-dot-git-trash hooks      # 仓库级 hooks 脚本
delete-dot-git-trash logs       # 本地 commit 历史记录
delete-dot-git-trash branches   # 历史遗留目录(已废弃)
echo
@D9 'delete all unreachable objects then do compress'
echo
git gc --prune=now --aggressive
echo
