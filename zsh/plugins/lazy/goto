# 快速切换工作目录
declare -gA ZETA_GOTO_MAPS

# 目录切换 -> goto nick
# 别名注册 -> goto nick path/to/...
function goto() {
  local -a nicks
  nicks=( ${(ok)ZETA_GOTO_MAPS} )

  if [[ $# -eq 2 ]]; then
    [[ -z "$1" ]] && {
      builtin echo
      builtin echo "$(@G9 goto) $(@Y9 nicks) $(B3 path/to/...) register new map."
      builtin echo
      return 1
    } >&2

    [[ ! -d "$2" ]] && {
      # builtin echo "SKIP: no target directory $(@R3 $2)"
      return 1
    } >&2

    local key val
    for key in ${nicks[@]}; do
      val="${ZETA_GOTO_MAPS[${key}]:-}"
      # Make sure nick & path maps one-to-one
      [[ -n "${val}" && "${val}" == "$2" ]] && {
        unset -v "ZETA_GOTO_MAPS[${key}]"
        ZETA_GOTO_MAPS["$1"]="$2"
        return
      }
      [[ "${key}" == "$1" ]] && {
        [[ "${val}" == "$2" ]] && return
        ZETA_GOTO_MAPS["$1"]="$2"
        return
      }
    done

    ZETA_GOTO_MAPS[$1]="$2"
    return
  fi

  function goto±help() {
    local key width=0 xkey
    for key in ${nicks[@]}; do
      # 计算别名字符串最大长度
      (( ${#key} > ${width} )) && width=${#key}
    done

    builtin echo "$(@G9 goto) $(@R3 where)"
    for key in ${nicks[@]}; do
      builtin printf -v xkey "%${width}s" ${key}
      builtin echo "  $(@Y9 "${xkey}") $(@D9 '->') $(@B3 "${ZETA_GOTO_MAPS[${key}]}")"
    done

    unset -f goto±help
  }

  [[ $# -eq 0 || $# -ne 1 || -z "$1" ]] && { goto±help; return; }

  if [[ -z "${ZETA_GOTO_MAPS[$1]}" ]]; then
    goto±help; builtin echo
    builtin echo "Nickname $(@R3 $1) not set yet!"
    builtin echo "Run $(@Y9 goto-register) $(@R3 $1) $(@C3 path/to/...) add new map."
    builtin echo; return 1
  fi

  if [[ ! -d "${ZETA_GOTO_MAPS[$1]}" ]]; then
    builtin echo
    builtin echo "$(@Y9 "$1") $(@D9 '->') $(@R3 ${where}) directory is missing ..."
    builtin echo; return 2
  fi

  builtin cd "${ZETA_GOTO_MAPS[$1]}"
}

function @zeta:comp-goto() {
  local -a nicks=( ${(k)ZETA_GOTO_MAPS} )
  _describe 'command' nicks
}

compdef @zeta:comp-goto goto
